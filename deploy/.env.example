PROVENA_VERSION=0.1.10
POSTGRES_PASSWORD=replace-with-a-random-database-password
BOOTSTRAP_TOKEN=replace-with-a-long-random-bootstrap-token

# Fill these after running `provena init`; they are used only by the console profile.
PROVENA_API_KEY=
PROVENA_SCOPE_ID=

# Used only with compose.ollama.yaml.
EXTRACTION_MODEL=qwen2.5:1.5b
EMBEDDING_MODEL=nomic-embed-text
